@report{Zhang,
   abstract = {Autoencoder has drawn lots of attention in the field of image processing. As the target output of autoencoder is the same as its input, autoencoder can be used in many useful applications such as data compression and data de-nosing[1]. In this paper, we compare and implement the two auto encoders with different architectures. The first autoencoder is the simple autoencoder(SAE) with one hidden layer. Another autoencoder is and convolution au-toencoder[9]. We compare these two autoencoders in two different tasks: image compression and image de-noising. We show that convolutional autoencoder performs better than the simple autoencoder.},
   author = {Yifei Zhang},
   keywords = {Autoencoder ·,Convolutional,Deep learning},
   title = {A Better Autoencoder for Image: Convolutional Autoencoder},
}


